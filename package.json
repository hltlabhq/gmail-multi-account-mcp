{
  "name": "gmail-multi-account-mcp",
  "version": "0.0.0",
  "private": true,
  "description": "Hosted Gmail MCP server for a small team — multi-account, per-teammate isolated.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run && vitest run -c vitest.workers.config.ts",
    "test:node": "vitest run",
    "test:integration": "vitest run -c vitest.workers.config.ts",
    "test:watch": "vitest",
    "migrate:local": "wrangler d1 migrations apply DB --local",
    "migrate:remote": "wrangler d1 migrations apply DB --remote",
    "admin": "node --experimental-strip-types bin/admin.ts",
    "postinstall": "patch-package"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.5.0",
    "@cloudflare/workers-types": "^4.20260521.1",
    "@types/node": "^22.19.19",
    "patch-package": "^8.0.1",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "wrangler": "3.114.17"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@cloudflare/workers-oauth-provider": "^0.0.5",
    "@modelcontextprotocol/sdk": "^1.0.0"
  }
}
